<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.motorfraude</groupId>
        <artifactId>motor-fraude-parent</artifactId>
        <version>0.1.0</version>
        <relativePath/>
    </parent>

    <artifactId>contracts</artifactId>
    <name>contracts</name>
    <description>JSON Schemas versionados, records Java e codec JSON compartilhados por todos os serviços.</description>

    <dependencies>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- test-jar: publica ContractAssertions para os testes de contrato dos produtores (plan 000 §3.3) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Artefatos compartilhados: GitHub Packages (repositórios privados). Leitura e escrita exigem um token
         configurado no ~/.m2/settings.xml com o id github-motor-fraude (ver README). Sem registry, use ./mvnw install
         nos repositórios motor-fraude-parent, contracts e platform-commons, nessa ordem. -->
    <repositories>
        <repository>
            <id>github-motor-fraude</id>
            <url>https://maven.pkg.github.com/luizavramos/*</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>github-motor-fraude</id>
            <url>https://maven.pkg.github.com/luizavramos/contracts</url>
        </repository>
    </distributionManagement>
</project>
